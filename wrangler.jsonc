/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "github-issues-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	/**
	 * Comma-separated GitHub logins permitted to use this server. The PAT is
	 * checked against this list at /authorize via GET /user, and re-checked on
	 * every MCP request. Not a secret — it is only an allowlist.
	 */
	"vars": {
		"ALLOWED_LOGINS": "zaccomode",
	},
	/**
	 * Grant and token storage for @cloudflare/workers-oauth-provider. The
	 * binding must be named OAUTH_KV. Grant props (which hold the PAT) are
	 * stored encrypted using the issued token as key material.
	 */
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "c6e39a0931b64d6abd74650c99208cd7",
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
}
