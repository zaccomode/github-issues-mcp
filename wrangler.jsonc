/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "github-issues-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": ["nodejs_compat"],
	/**
	 * None of these are secrets. The App id, slug and OAuth client id are all
	 * visible to anyone who reaches the install page; the private key and the
	 * client secret are Worker secrets and never appear here.
	 *
	 * PUBLIC_URL must match the GitHub App's registered callback URL exactly. It
	 * is what we hand GitHub as `redirect_uri`, deliberately in preference to
	 * anything derived from the inbound request's Host header.
	 */
	"vars": {
		"GITHUB_APP_ID": "",
		"GITHUB_APP_SLUG": "",
		"GITHUB_CLIENT_ID": "",
		"PUBLIC_URL": "http://localhost:8787",
		"DEFAULT_MONTHLY_QUOTA": "5000",
	},
	/**
	 * OAUTH_KV is the provider's own grant and token store; that binding name is
	 * fixed by @cloudflare/workers-oauth-provider. CACHE is ours — installation
	 * tokens, OAuth state nonces, and other short-lived lookups. Kept separate so
	 * that purging one never touches the other.
	 */
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "c6e39a0931b64d6abd74650c99208cd7",
		},
		{
			"binding": "CACHE",
			"id": "PLACEHOLDER_RUN_WRANGLER_KV_NAMESPACE_CREATE_CACHE",
		},
	],
	/**
	 * Tenant records, connection history, and usage counters. Deliberately holds
	 * no credentials — see the comment at the top of src/auth/crypto.ts.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "github-issues-mcp",
			"database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE",
			"migrations_dir": "migrations",
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
}
