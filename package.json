{
  "name": "github-issues-mcp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src/",
    "format": "oxfmt src/",
    "check": "npm run lint && npm run type-check",
    "db:migrate": "wrangler d1 migrations apply github-issues-mcp --remote",
    "db:migrate:local": "wrangler d1 migrations apply github-issues-mcp --local"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agents": "^0.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "7.0.2",
    "wrangler": "^4.164.0"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    }
  }
}
