{
  "name": "github-issues-mcp",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "deploy": "npm run db:migrate && wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "oxlint src/ test/",
    "format": "oxfmt src/ test/",
    "check": "npm run lint && npm run type-check",
    "db:migrate": "wrangler d1 migrations apply github-issues-mcp --remote",
    "db:migrate:local": "wrangler d1 migrations apply github-issues-mcp --local",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agents": "^0.17.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    }
  }
}
